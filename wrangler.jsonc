{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lpn",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      ".gemini",
      ".gemini/**",
      "README.md"
    ]
  }
}
